{
  "$comment": "SP Wallet Design System (NEXT) — the single source of every design value. Generated outputs: apps/web/src/tokens.css and design/generated/SPWalletTokens.swift (scripts/gen-design-tokens.mjs). Never edit the outputs; never write a literal colour, size, radius or duration in a screen.",
  "version": "2.0.0",
  "color": {
    "$comment": "light / dark. Semantic names only. Every text pair listed in `contrast` is checked at generation (WCAG 2.x, >= 4.5:1).",
    "bg":        { "light": "#f3f4f7", "dark": "#06080c", "role": "window background" },
    "surface":   { "light": "#ffffff", "dark": "#0f131b", "role": "cards, sheets, rows" },
    "elev":      { "light": "#eceef3", "dark": "#1a202c", "role": "wells, pressed rows, segmented track, skeleton" },
    "line":      { "light": "#0d12201a", "dark": "#f0f4ff17", "role": "hairlines (alpha)" },
    "ink":       { "light": "#0a0d14", "dark": "#f4f6fa", "role": "primary text, amounts" },
    "mute":      { "light": "#596273", "dark": "#98a2b6", "role": "secondary text, labels" },
    "accent":    { "light": "#1d4ed8", "dark": "#8fb2ff", "role": "interactive: links, focus ring, selected controls, chart line" },
    "positive":  { "light": "#087a55", "dark": "#35e7ac", "role": "gain, confirmed, ok — always with sign / icon / word" },
    "negative":  { "light": "#c22a40", "dark": "#ff7d88", "role": "loss, failed, destructive" },
    "caution":   { "light": "#9a5b06", "dark": "#f4b65b", "role": "warning, pending attention, dropped / replaced" },
    "primary":   { "light": "#0a0d14", "dark": "#f4f6fa", "role": "primary button fill" },
    "onPrimary": { "light": "#ffffff", "dark": "#0a0d14", "role": "text on primary" },
    "onNegative":{ "light": "#ffffff", "dark": "#2a0508", "role": "text on a destructive button" },
    "plate":     { "light": "#ffffff", "dark": "#1e2533", "role": "logo plate, QR plate (QR plate is always #ffffff)" },
    "heroBase":  { "light": "#0b1020", "dark": "#0b1020", "role": "balance card base — the same in both themes" },
    "heroInk":   { "light": "#ffffff", "dark": "#ffffff", "role": "text on the balance card" },
    "heroMute":  { "light": "#d3dae8", "dark": "#d3dae8", "role": "secondary text on the balance card" }
  },
  "gradient": {
    "$comment": "The only gradient of the system: the balance card's aurora. Three radial lights over heroBase; text never sits on a stop lighter than the checked ones.",
    "aurora": { "base": "#0b1020", "lights": [
      { "color": "#2747d9", "alpha": 0.50, "x": 0.10, "y": 0.00, "radius": 0.85 },
      { "color": "#0f9d7a", "alpha": 0.36, "x": 1.00, "y": 0.10, "radius": 0.75 },
      { "color": "#6d3fe0", "alpha": 0.26, "x": 0.55, "y": 1.20, "radius": 0.80 } ] }
  },
  "series": {
    "$comment": "Data-viz series in fixed order (allocation). A part is always named with its share in text.",
    "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#7a5af5", "#8a93a3"],
    "dark":  ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#8f77f7", "#6b7486"],
    "names": ["s1", "s2", "s3", "s4", "s5", "s6", "other"]
  },
  "type": {
    "$comment": "size in px at the default text size (web: emitted in rem, 16px root; Apple: mapped to a Dynamic Type text style and scaled relative to it). weight is numeric; tracking in em; lineHeight unitless. `figures`: tabular for anything in a column, proportional for display amounts.",
    "display":  { "size": 44, "weight": 650, "tracking": -0.04,  "lineHeight": 1.05, "figures": "proportional", "appleStyle": "largeTitle", "role": "total balance, asset price, amount on a review" },
    "title1":   { "size": 30, "weight": 650, "tracking": -0.028, "lineHeight": 1.1,  "figures": "proportional", "appleStyle": "title",      "role": "page title" },
    "title2":   { "size": 22, "weight": 620, "tracking": -0.02,  "lineHeight": 1.18, "figures": "proportional", "appleStyle": "title2",     "role": "section title, sheet title" },
    "headline": { "size": 17, "weight": 600, "tracking": -0.01,  "lineHeight": 1.3,  "figures": "tabular",      "appleStyle": "headline",   "role": "card heading, row title" },
    "body":     { "size": 15, "weight": 400, "tracking": -0.005, "lineHeight": 1.45, "figures": "tabular",      "appleStyle": "body",       "role": "rows, paragraphs" },
    "bodyStrong":{ "size": 15, "weight": 600, "tracking": -0.005, "lineHeight": 1.45, "figures": "tabular",     "appleStyle": "body",       "role": "amounts in rows, buttons" },
    "callout":  { "size": 14, "weight": 400, "tracking": 0,      "lineHeight": 1.42, "figures": "tabular",      "appleStyle": "callout",    "role": "secondary lines, notices" },
    "footnote": { "size": 13, "weight": 400, "tracking": 0,      "lineHeight": 1.4,  "figures": "tabular",      "appleStyle": "footnote",   "role": "hints, provenance, time stamps" },
    "eyebrow":  { "size": 11.5, "weight": 600, "tracking": 0.06, "lineHeight": 1.3,  "figures": "tabular",      "appleStyle": "caption",    "uppercase": true, "role": "section labels" },
    "micro":    { "size": 11, "weight": 500, "tracking": 0.01,   "lineHeight": 1.25, "figures": "tabular",      "appleStyle": "caption2",   "role": "tab labels, chart axis ends" },
    "mono":     { "size": 13, "weight": 400, "tracking": 0,      "lineHeight": 1.45, "figures": "tabular",      "appleStyle": "footnote",   "mono": true, "role": "addresses, hashes, base units" }
  },
  "space":  { "$comment": "4-pt grid", "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "layout": { "gutter": 20, "cardPadding": 20, "rowMin": 60, "assetRow": 68, "target": 44, "contentMax": 1120, "readingMax": 672, "sidebar": 256 },
  "radius": { "xs": 8, "sm": 12, "md": 16, "lg": 22, "xl": 28, "full": 999 },
  "elevation": {
    "$comment": "e1 resting card · e2 raised control, popover · e3 sheet, balance card. Dark: a lighter surface and an inner highlight instead of a larger shadow.",
    "e1": { "light": "0 1px 1px rgba(13,18,32,0.03), 0 6px 20px -10px rgba(13,18,32,0.12)", "dark": "inset 0 1px 0 rgba(255,255,255,0.035), 0 8px 24px -14px rgba(0,0,0,0.8)", "apple": { "y": 6, "blur": 20, "opacity": 0.10 } },
    "e2": { "light": "0 2px 4px rgba(13,18,32,0.06), 0 12px 28px -10px rgba(13,18,32,0.28)", "dark": "inset 0 1px 0 rgba(255,255,255,0.06), 0 12px 28px -10px rgba(0,0,0,0.85)", "apple": { "y": 12, "blur": 28, "opacity": 0.18 } },
    "e3": { "light": "0 -8px 40px -12px rgba(13,18,32,0.3), 0 24px 56px -24px rgba(13,18,32,0.5)", "dark": "inset 0 1px 0 rgba(255,255,255,0.06), 0 -12px 48px -12px rgba(0,0,0,0.9)", "apple": { "y": 24, "blur": 56, "opacity": 0.28 } }
  },
  "motion": {
    "$comment": "transform and opacity only; all durations collapse to 0 under reduced motion; an amount the owner is about to approve is never animated.",
    "duration": { "instant": 90, "fast": 140, "base": 220, "slow": 360 },
    "easing": { "standard": [0.2, 0, 0, 1], "spring": [0.22, 1, 0.36, 1], "exit": [0.4, 0, 1, 1] },
    "appleSpring": { "response": 0.36, "damping": 0.86 }
  },
  "status": {
    "$comment": "The transfer life cycle (API field `lifecycle`) — one tone, one symbol, one word per value on the three platforms. symbol = SF Symbol name (Apple) / icon id (web). Colour never carries the meaning alone.",
    "draft":                 { "tone": "mute",     "symbol": "pencil",                       "fr": "Brouillon",             "en": "Draft" },
    "awaiting_confirmation": { "tone": "accent",   "symbol": "hand.tap",                     "fr": "À confirmer",           "en": "Awaiting confirmation" },
    "awaiting_signature":    { "tone": "accent",   "symbol": "signature",                    "fr": "Signature en cours",    "en": "Awaiting signature" },
    "signed":                { "tone": "accent",   "symbol": "checkmark.seal",               "fr": "Signée",                "en": "Signed" },
    "broadcasting":          { "tone": "accent",   "symbol": "dot.radiowaves.left.and.right","fr": "Envoi au réseau",       "en": "Broadcasting" },
    "pending":               { "tone": "caution",  "symbol": "clock",                        "fr": "En attente",            "en": "Pending" },
    "confirming":            { "tone": "accent",   "symbol": "clock.badge.checkmark",        "fr": "En confirmation",       "en": "Confirming" },
    "confirmed":             { "tone": "positive", "symbol": "checkmark.circle.fill",        "fr": "Confirmée",             "en": "Confirmed" },
    "failed":                { "tone": "negative", "symbol": "xmark.octagon.fill",           "fr": "Échouée",               "en": "Failed" },
    "replaced":              { "tone": "caution",  "symbol": "arrow.triangle.2.circlepath",  "fr": "Remplacée",             "en": "Replaced" },
    "dropped":               { "tone": "caution",  "symbol": "questionmark.circle",          "fr": "Non incluse",           "en": "Dropped" },
    "expired":               { "tone": "mute",     "symbol": "hourglass.bottomhalf.filled",  "fr": "Expirée",               "en": "Expired" },
    "rejected":              { "tone": "mute",     "symbol": "hand.raised",                  "fr": "Refusée par vous",      "en": "Rejected" },
    "not_sent":              { "tone": "mute",     "symbol": "paperplane.slash",             "fr": "Signée, non envoyée",   "en": "Signed, not sent" }
  },
  "contrast": [
    ["ink", "surface"], ["ink", "bg"], ["ink", "elev"], ["mute", "surface"], ["mute", "bg"], ["mute", "elev"],
    ["accent", "surface"], ["accent", "bg"], ["positive", "surface"], ["positive", "bg"], ["negative", "surface"], ["negative", "bg"],
    ["caution", "surface"], ["caution", "bg"], ["onPrimary", "primary"], ["onNegative", "negative"], ["heroInk", "heroBase"], ["heroMute", "heroBase"]
  ]
}

# SP Wallet — NFT (delivery 1, read-only): optional variables of the API process. Names and shapes only — no real value here.
# With none of them set the feature runs in its degraded mode (docs/nft/NFT-SOURCES.md §1).

# NFT_ENABLED=off                      # turn the NFT routes off

# Solana — compressed NFTs and holder hints come from a DAS index. Unset: the wallet's own Solana RPC endpoints are probed.
# NFT_SOLANA_DAS_URL=https://<das-provider-host>/<path-or-query-carrying-your-key>
# NFT_SOLANA_DAS=off                   # never ask a DAS index

# EVM — automatic discovery needs an indexer; this SENDS THE WALLET'S EVM ADDRESS to the hosts listed. Blockscout-compatible instances.
# NFT_EVM_INDEXER_URLS={"ethereum":"https://<blockscout-instance>","optimism":"https://<blockscout-instance>"}

# Market read data for Solana (Magic Eden public API; sends the mint only). Read its API terms first.
# NFT_MARKET_MAGICEDEN=on

# Gateways (comma-separated https bases, tried in order)
# NFT_IPFS_GATEWAYS=https://<gateway-1>/ipfs/,https://<gateway-2>/ipfs/
# NFT_ARWEAVE_GATEWAYS=https://<gateway>/

# Cache and budgets
# NFT_CACHE_DIR=/path/to/nft-media-cache
# NFT_CACHE_MAX_BYTES=1073741824
# NFT_MEDIA_MAX_BYTES=26214400
# NFT_FETCH_DAILY_REQUESTS=5000
# NFT_FETCH_DAILY_BYTES=2147483648
# NFT_INVENTORY_MAX=500

# Bitcoin inscription SAFETY (delivery 2) — a self-hosted `ord` server (https, or a loopback address): ordinary BTC sends never
# select an output it reports as carrying an inscription or a rune, or does not know. Set and unreachable = BTC sends refused.
# Unset = a heuristic (outputs of at most 10 000 sat are kept aside until reviewed). No inscription is listed or transferred.
# NFT_ORDINALS_API_URL=http://127.0.0.1:8080

# Reserved names — read by no code in this delivery:
# OPENSEA_API_KEY=            (OpenSea API v2: mandatory x-api-key)
# NFT_EVM_PROVIDER_API_KEY=   (a keyed EVM NFT index such as Alchemy NFT API v3)

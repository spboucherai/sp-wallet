{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sp-wallet.local/schema/signal-input.schema.json",
  "title": "Input of python -m spq.signal",
  "type": "object",
  "required": [
    "candles"
  ],
  "properties": {
    "candles": {
      "type": "object",
      "description": "exactly the symbols of META['universe']; closed bars, oldest first, [ts, open, high, low, close, volume]",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": [
                "string",
                "number"
              ],
              "description": "bar-open time: ISO 8601 UTC or epoch seconds"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "description": "optional; must equal the bar-open time of the last bar supplied"
    },
    "interval": {
      "type": "string",
      "description": "optional; must equal META['interval']"
    }
  },
  "additionalProperties": false
}

{
  "name": "sp-wallet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/swap && tsc -p packages/derivatives && tsc -p services/isolated-signer && tsc -p services/api && tsc -p apps/web",
    "test": "vitest run",
    "build": "node scripts/build.mjs && (cd apps/web && node_modules/.bin/vite build)",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "7.5.0",
    "@bitauth/libauth": "3.0.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@mysten/sui": "2.39.1",
    "@near-js/crypto": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@playwright/test": "1.65.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@simplewebauthn/server": "14.1.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@spw/core": "workspace:*",
    "@spw/derivatives": "workspace:*",
    "@spw/swap": "workspace:*",
    "@stellar/stellar-base": "15.0.0",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "16.3.0",
    "@types/node": "26.6.6",
    "bitcoinjs-lib": "7.0.5",
    "cosmjs-types": "0.11.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "near-seed-phrase": "0.2.1",
    "tronweb": "6.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "viem": "2.57.17",
    "vitest": "5.1.0",
    "xrpl": "5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
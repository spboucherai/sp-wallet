{
  "name": "sp-wallet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p services/isolated-signer && tsc -p services/api && tsc -p apps/web",
    "test": "vitest run",
    "build": "node scripts/build.mjs && (cd apps/web && node_modules/.bin/vite build)",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@simplewebauthn/server": "14.1.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@spw/core": "workspace:*",
    "@stellar/stellar-base": "15.0.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tronweb": "6.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "xrpl": "5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
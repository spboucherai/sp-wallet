// TypeScript types of the SP Wallet core API for the web app, generated from the OpenAPI document (docs/openapi/wallet-v1.json).
// Called by scripts/gen-openapi.mts (which writes apps/web/src/generated/wallet-api.ts) and by a test that compares the
// committed file with what this gives. JSON Schema → TypeScript is the trading SDK's own converter (no dependency).
import { tsType } from '../../packages/trading-sdk/scripts/gen-types.mts';

type Json = Record<string, unknown>;
/** the document's own extension members are not JSON Schema: they are read here, then removed before the conversion */
const clean = (node: unknown): unknown => (Array.isArray(node) ? node.map(clean) : node === null || typeof node !== 'object' ? node
  : Object.fromEntries(Object.entries(node as Json).filter(([k]) => !k.startsWith('x-spw-')).map(([k, v]) => [k, clean(v)])));
const pascal = (id: string): string => id[0]!.toUpperCase() + id.slice(1);
const screaming = (name: string): string => name.replace(/([a-z0-9])([A-Z])/g, '$1_$2').toUpperCase();
const typeName = (name: string): string => (name === 'Error' ? 'ApiErrorBody' : name);
const comment = (s: unknown): string => (typeof s === 'string' && s ? `/** ${s.replace(/\*\//g, '*\\/')} */\n` : '');

export function generateWalletTypes(document: Json): string {
  const L: string[] = [];
  L.push('// GENERATED by scripts/gen-openapi.mts from docs/openapi/wallet-v1.json (the contract of the SP Wallet core API) — do not edit.',
    '// Source of truth: services/api/src/wallet-api/spec.ts. A test compares this file with what the generator gives.',
    '// Objects are open (`[extra: string]: unknown`): the API is additive, ignore what you do not know.', '/* eslint-disable */', '');
  L.push(`export const WALLET_API_VERSION = ${JSON.stringify((document.info as Json).version)};`, '');
  const schemas = (document.components as Json).schemas as Record<string, Json>;
  L.push(`// ${'-'.repeat(100)} enumerations`, '// OPEN enumerations accept any string: new values may appear in a later release — always keep a fallback branch.');
  for (const [name, s] of Object.entries(schemas)) {
    if (!Array.isArray(s['x-spw-values'])) continue;
    const values = s['x-spw-values'] as string[], open = s['x-spw-open'] === true, c = `${screaming(name)}_VALUES`;
    L.push(`${comment(`${s.description as string}${open ? ' OPEN: new values may appear.' : ' CLOSED: frozen.'}`)}export const ${c} = [${values.map((v) => JSON.stringify(v)).join(', ')}] as const;`,
      `export type ${name} = (typeof ${c})[number]${open ? ' | (string & {})' : ''};`);
  }
  L.push('', `// ${'-'.repeat(100)} components`);
  for (const [name, s] of Object.entries(schemas)) { if (Array.isArray(s['x-spw-values'])) continue; L.push(`${comment(s.description)}export type ${typeName(name)} = ${tsType(clean(s))};`); }
  L.push('');
  const ops: { id: string; method: string; path: string; o: Json }[] = [];
  for (const [p, item] of Object.entries(document.paths as Record<string, Record<string, Json>>)) for (const [method, o] of Object.entries(item)) ops.push({ id: o.operationId as string, method: method.toUpperCase(), path: p, o });
  for (const { id, method, path, o } of ops) {
    const P = pascal(id), params = (o.parameters ?? []) as Json[], query = params.filter((x) => x.in === 'query');
    L.push(`// ${'-'.repeat(100)} ${id}: ${method} ${path}`);
    if (query.length) {
      L.push(`export interface ${P}Query {`);
      for (const q of query) L.push(`${q.description ? `  /** ${String(q.description).replace(/\*\//g, '*\\/')} */\n` : ''}  ${q.name as string}${q.required ? '' : '?'}: ${tsType(clean(Object.fromEntries(Object.entries(q.schema as Json).filter(([k]) => k !== 'default'))), '  ')};`);
      L.push('}');
    }
    const body = ((o.requestBody as Json | undefined)?.content as Json | undefined)?.['application/json'] as Json | undefined;
    if (body) L.push(`export type ${P}Body = ${tsType(clean(body.schema))};`);
    const ok = (((o.responses as Json)['200'] as Json).content as Json)['application/json'] as Json | undefined;
    if (ok) L.push(`export type ${P}Response = ${tsType(clean(ok.schema))};`);
    L.push('');
  }
  L.push('/** every operation of the document: method, path template, whether it needs the owner session and the CSRF headers, and its answer type */', 'export const WALLET_OPERATIONS = {');
  for (const { id, method, path, o } of ops) {
    const content = Object.keys(((o.responses as Json)['200'] as Json).content as Json)[0];
    L.push(`  ${id}: { method: ${JSON.stringify(method)}, path: ${JSON.stringify(path)}, auth: ${JSON.stringify(o['x-spw-auth'])}, csrf: ${String(o['x-spw-csrf'] === true)}, produces: ${JSON.stringify(content)}, since: ${JSON.stringify(o['x-spw-since'] ?? 'v1')}, changing: ${String(typeof o['x-spw-changing'] === 'string')} },`);
  }
  L.push('} as const;', 'export type WalletOperationId = keyof typeof WALLET_OPERATIONS;', '');
  L.push('/** every error answer an operation can give: `[HTTP status, code]`. `open`: a chain adapter or the signer can add a code of its own. */',
    'export const WALLET_OPERATION_ERRORS: Record<WalletOperationId, { open: boolean; errors: readonly (readonly [number, string])[] }> = {');
  for (const { id, o } of ops) L.push(`  ${id}: { open: ${String(o['x-spw-errors-open'] === true)}, errors: [${(o['x-spw-errors'] as { status: number; code: string }[]).map((e) => `[${e.status}, ${JSON.stringify(e.code)}]`).join(', ')}] },`);
  L.push('};', '');
  const cat = document['x-spw-error-catalog'] as Record<string, unknown>;
  L.push('/** the catalogued error codes (an operation marked `open` can answer others: keep a fallback) */', `export const WALLET_ERROR_CODES = [${Object.keys(cat).map((c) => JSON.stringify(c)).join(', ')}] as const;`,
    'export type WalletErrorCode = (typeof WALLET_ERROR_CODES)[number] | (string & {});', '');
  return L.join('\n');
}

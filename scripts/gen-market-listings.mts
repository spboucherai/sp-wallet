// Build-time discovery of spot listings against USD on the three market-data exchanges (public, keyless product endpoints).
// Writes packages/core/src/market-listings.ts: for every base ticker listed on AT LEAST TWO of Coinbase Exchange, Bitstamp
// and Kraken, the exact pair name on each. The table is static and reviewed in the diff; nothing is discovered at run time.
// It is deliberately wider than today's token registry: when the registry grows, new assets are picked up without a rebuild
// of this table (packages/core/src/market-symbols.ts intersects the two at run time).
// Run: node scripts/gen-market-listings.mts   (then read the diff)
import { writeFileSync } from 'node:fs';
import { join } from 'node:path';

const get = async (url: string): Promise<any> => { const r = await fetch(url, { headers: { accept: 'application/json', 'user-agent': 'sp-wallet-listings/1' }, signal: AbortSignal.timeout(30_000) }); if (!r.ok) throw new Error(`${url}: HTTP ${r.status}`); return r.json(); };
const TICKER = /^[A-Z0-9]{2,10}$/;
/** Kraken's own names for two assets */
const KRAKEN_BASE: Record<string, string> = { XBT: 'BTC', XDG: 'DOGE' };

const coinbase = new Map<string, string>(), bitstamp = new Map<string, string>(), kraken = new Map<string, string>();
for (const p of await get('https://api.exchange.coinbase.com/products') as any[])
  if (p.quote_currency === 'USD' && p.status === 'online' && !p.trading_disabled && !p.cancel_only && TICKER.test(p.base_currency) && p.id === `${p.base_currency}-USD`) coinbase.set(p.base_currency, p.id);
for (const p of await get('https://www.bitstamp.net/api/v2/markets/') as any[])
  if (p.counter_currency === 'USD' && p.market_type === 'SPOT' && p.trading === 'Enabled' && TICKER.test(p.base_currency) && p.market_symbol === `${String(p.base_currency).toLowerCase()}usd`) bitstamp.set(p.base_currency, p.market_symbol);
const kr = await get('https://api.kraken.com/0/public/AssetPairs');
if (kr.error?.length) throw new Error(`kraken: ${kr.error.join('; ')}`);
for (const p of Object.values(kr.result) as any[]) {
  if (p.status !== 'online' || typeof p.wsname !== 'string' || !/^[A-Z0-9]+$/.test(p.altname)) continue;
  const [b, q] = p.wsname.split('/');
  if (q !== 'USD') continue;
  const base = KRAKEN_BASE[b] ?? b;
  if (TICKER.test(base)) kraken.set(base, p.altname);
}
const all = [...new Set([...coinbase.keys(), ...bitstamp.keys(), ...kraken.keys()])].sort();
const rows = all.map((s) => ({ s, c: coinbase.get(s), b: bitstamp.get(s), k: kraken.get(s) })).filter((r) => [r.c, r.b, r.k].filter(Boolean).length >= 2);
const q = (v: string | undefined, key: string) => (v ? `${key}: '${v}'` : null);
const body = rows.map((r) => `  ${/^[A-Z][A-Z0-9]*$/.test(r.s) ? r.s : `'${r.s}'`}: { ${[q(r.c, 'coinbase'), q(r.b, 'bitstamp'), q(r.k, 'kraken')].filter(Boolean).join(', ')} },`).join('\n');
const out = `// GENERATED by scripts/gen-market-listings.mts on ${new Date().toISOString().slice(0, 10)} from the exchanges' public product endpoints — do not edit by hand.
//   coinbase  GET api.exchange.coinbase.com/products          (quote USD, online, trading enabled)   ${coinbase.size} USD pairs
//   bitstamp  GET www.bitstamp.net/api/v2/markets/            (counter USD, spot, trading enabled)   ${bitstamp.size} USD pairs
//   kraken    GET api.kraken.com/0/public/AssetPairs          (quote USD, online; pair = altname)    ${kraken.size} USD pairs
// Inclusion rule: the base ticker has a USD spot pair on at least two of the three exchanges (${rows.length} tickers).
// A ticker is NOT an identity: two exchanges can use one ticker for different assets. Nothing relies on this table alone —
// the market-data quality gate requires the sources to agree within 50 bps and the signer requires Coinbase and Kraken to
// agree within 1 %, so a ticker collision makes both refuse (fail closed).
export interface MarketListing { coinbase?: string; bitstamp?: string; kraken?: string }
export const MARKET_LISTINGS: Record<string, MarketListing> = {
${body}
};
`;
writeFileSync(join(import.meta.dirname, '../packages/core/src/market-listings.ts'), out);
console.log(`coinbase ${coinbase.size}, bitstamp ${bitstamp.size}, kraken ${kraken.size} USD pairs; ${rows.length} tickers on at least two; all three: ${rows.filter((r) => r.c && r.b && r.k).length}`);
